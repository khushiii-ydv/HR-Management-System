# ============================================================
# HRMS — Enterprise Web Server Security Configuration (.htaccess)
# ============================================================

# 1. Disable directory browsing
Options -Indexes

# 2. Block direct web access to sensitive environment, config & source files
<FilesMatch "^(\.env|\.git|composer\.(json|lock|phar)|package\.json|.*\.sql|.*\.log|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct web access to sensitive internal directories
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and directories
    RewriteRule "(^|/)\.(?!well-known)" - [F]

    # Block direct access to internal server-side directories
    RewriteRule ^(config|database|logs|vendor|scratch)/ - [F,L]
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
    # Prevent MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

