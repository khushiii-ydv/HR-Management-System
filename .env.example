# ============================================================
# HRMS — Environment Configuration Example
# ============================================================
# This file is SAFE to commit to version control.
# Copy this template to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ----------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------
APP_NAME="HRMS"
APP_ENV=development             # development | staging | production
APP_DEBUG=true                  # Set to false in production
APP_URL=http://localhost/hr-management-system

# ----------------------------------------------------------
# Database Configuration (MySQL / MariaDB via XAMPP)
# ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_management_system
DB_USERNAME=root
DB_PASSWORD=                    # Leave blank for default XAMPP; set in production

# ----------------------------------------------------------
# SMTP Email Delivery (PHPMailer)
# Supports: Gmail, Amazon SES, Brevo, Mailtrap, Mailpit, etc.
# ----------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_ENCRYPTION=tls             # tls (port 587) | ssl (port 465)
MAIL_FROM_ADDRESS=no-reply@hrms.com
MAIL_FROM_NAME="HR Management System"
MAIL_REPLY_TO=no-reply@hrms.com

# ----------------------------------------------------------
# OTP & Security Policies
# ----------------------------------------------------------
SESSION_LIFETIME=1800           # Inactivity timeout in seconds (30 mins)
REQUIRE_2FA=true                # Require 2FA for elevated roles (HR/Admin)
OTP_EXPIRY_MINUTES=10           # OTP expiration lifetime (minutes)
OTP_MAX_ATTEMPTS=5              # Maximum incorrect guesses before code invalidation
OTP_RESEND_COOLDOWN=60          # Minimum seconds between resend requests

# ----------------------------------------------------------
# Official Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/apis/credentials
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost/hr-management-system/auth/google_callback.php

# ----------------------------------------------------------
# Enterprise Logging
# ----------------------------------------------------------
LOG_CHANNEL=file
LOG_PATH=logs/app.log
LOG_LEVEL=debug                 # debug | info | warning | error
